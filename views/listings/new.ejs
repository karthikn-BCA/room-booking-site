<!DOCTYPE html>
<html lang="en">
<head>
     <meta charset="UTF-8">
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <title>WonderLust</title>
</head>
<body>
     <h3>Create a New Listings</h3>
     <form method= "POST" action="/listings">
          <input name="listing[title]" placeholder="Enter Title" type="text">
          <br><br>
          <textarea name="listing[description]" placeholder="Ente description"></textarea>
          <br><br>
          <input name="listing[immage]" placeholder="Enter immage URL/link" type="text">
          <br><br>
          <input name="listing[price]" placeholder="Enter price" type="text">
          <br><br>
          <input name="listing[country]" placeholder="Enter country" type="text">
          <br><br>
          <input name="listing[location]" placeholder="Enter location" type="text">
          <br>
          <button>Add</button>
     </form>
</body>
</html>